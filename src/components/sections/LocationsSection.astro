---
import { Image } from 'astro:assets';
import fondoSedes from '../../assets/fondo-sedes.webp';
---

<section
  id="sedes"
  class="section section-locations"
  aria-labelledby="sedes-title"
>
  <Image
    src={fondoSedes}
    alt=""
    class="section-locations-bg"
    loading="lazy"
    role="presentation"
    aria-hidden="true"
    width={1600}
    height={900}
  />
  <div class="section-inner">
    <header class="section-header-centered">
      <h2 id="sedes-title">SEDES</h2>
    </header>
    <div class="locations-grid" aria-label="Sedes de Iglesias CENFOLIC">
      <article class="location-card">
        <div class="location-icon" aria-hidden="true">
          <svg
            stroke="currentColor"
            fill="currentColor"
            stroke-width="0"
            viewBox="0 0 16 16"
            height="200px"
            width="200px"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L2 8.207V13.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5V8.207l.646.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM13 7.207V13.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V7.207l5-5z"
            >
