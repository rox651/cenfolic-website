<style>
  .section {
    padding: var(--spacing-section-y) var(--spacing-page-x);
  }

  .section-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .section-header-centered {
    text-align: center;
    margin-bottom: 2.75rem;
  }

  .section-header-centered h2 span {
    font-style: italic;
  }

  .section-locations {
    position: relative;
    background: linear-gradient(
      to bottom,
      var(--color-surface-soft),
      #e6f0ff
    );
  }

  .section-locations .section-inner {
    border-radius: 26px;
    padding: 1rem 2.4rem;
    position: relative;
    overflow: hidden;
  }

  .section-locations-bg {
    position: absolute;
    inset: 0;
    opacity: 0.03;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .section-locations .section-header-centered {
    position: relative;
    z-index: 1;
  }

  .section-locations .section-header-centered h2 {
    font-size: var(--font-size-h2);
    color: var(--color-primary);
  }

  .locations-grid {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-grid-gap);
  }

  .location-card {
    flex: 1 1 200px;
    text-align: center;
    padding: 1rem;
  }

  .location-card h3 {
    font-size: 1.3rem;
    margin-bottom: 0.3rem;
    color: var(--color-primary);
    text-transform: uppercase;
  }

  .location-card p {
    font-size: var(--font-size-small);
    text-wrap: pretty;
  }

  .location-icon {
    width: 65px;
    height: 50px;
    margin: 0 auto 0.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (width <= 1024px) {
    .locations-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (width <= 768px) {
    .locations-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

