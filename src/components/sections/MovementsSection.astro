---
---

<section
  id="movimientos"
  class="section section-movements"
  aria-labelledby="movimientos-title"
>
  <div class="section-inner">
    <header class="section-header-inline">
      <h2 id="movimientos-title">MOVIMIENTOS</h2>
      <p>
        Trabajamos a través de distintos movimientos que atienden las
        <span>distintas etapas y áreas de la vida</span>.
      </p>
    </header>
    <div class="movements-grid">
      <article class="movement-card">
        <h3>Hombres de Verdad</h3>
      </article>
      <article class="movement-card">
        <h3>Movimiento de mujeres</h3>
      </article>
      <article class="movement-card">
        <h3>VIP &amp; PEC</h3>
        <p>Profesionales y ejecutivos cristianos.</p>
      </article>
      <article class="movement-card">
        <h3>Movimiento infantil</h3>
        <p>Niños de 4 - 8 años.</p>
      </article>
      <article class="movement-card">
        <h3>Generación impacto</h3>
        <p>9 - 12 años preadolescentes.</p>
      </article>
      <article class="movement-card">
        <h3>Conexión Total</h3>
        <p>13 - 18 años estudiantes enseñanza media.</p>
      </article>
      <article class="movement-card">
        <h3>Movimiento universitario cristiano</h3>
      </article>
      <article class="movement-card">
        <h3>Encuentros matrimoniales</h3>
      </article>
      <article class="movement-card">
        <h3>MOVEM</h3>
        <p>Movimiento de empresarios y emprendedores.</p>
      </article>
    </div>
  </div>
</section>


<style>
  .section {
    padding: var(--spacing-section-y) var(--spacing-page-x);
  }

  .section-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .section-header-inline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: baseline;
    margin-bottom: 2.5rem;
  }

  .section-header-inline h2 {
    font-size: var(--font-size-h2);
  }

  .section-header-inline p {
    max-width: 520px;
  }

  .section-header-inline span {
    font-weight: 700;
  }

  .section-movements {
    background-color: var(--color-surface);
  }

  .section-movements h2 {
    color: var(--color-primary);
  }

  .movements-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-grid-gap);
  }

  .movement-card {
    border-radius: 18px;
    background-color: var(--color-primary);
    color: var(--color-text-soft);
    padding: 1.3rem 1.25rem;
    text-align: center;
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .movement-card h3 {
    font-size: 1rem;
    margin-bottom: 0.35rem;
  }

  .movement-card p {
    font-size: var(--font-size-small);
  }

  @media (width <= 768px) {
    .movements-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

