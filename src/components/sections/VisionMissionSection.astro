<section
  id="vision-mision"
  class="section section-vision-mission"
  aria-labelledby="vision-title"
>
  <div class="section-inner">
    <header class="vision-header">
      <div class="vision-text">
        <h2 id="vision-title">VISIÓN</h2>
      </div>
      <div class="vision-pillars" aria-label="Pilares de la visión">
        <p>
          Guiar a las personas a un encuentro personal con Jesucristo, formar líderes
          con visión y valores del Reino, e impactar comunidades y naciones con el
          poder transformador del Evangelio.
        </p>
        <article class="pillar-card">
          <div class="pillar-icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              xmlns:xlink="http://www.w3.org/1999/xlink"
              data-name="Layer 39"
              preserveAspectRatio="xMidYMid meet"
              version="1.0"
              viewBox="0.5 0.3 47.7 47.7"
              zoomAndPan="magnify"
              style="fill: rgb(13, 47, 91)"
              width="52"
              height="52"
            >
