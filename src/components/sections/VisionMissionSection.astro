                  style="fill: inherit"
                />
              </g>
            </svg>
          </div>
          <h3>CONOCER</h3>
          <p>Encontrar a Jesucristo personalmente.</p>
        </article>
        <article class="pillar-card">
          <div class="pillar-icon" aria-hidden="true">
            <svg
              stroke="currentColor"
              fill="currentColor"
