---
import {
  importantDates,
  isPastDate,
  getFeaturedIndex,
} from "../../helpers/importantDates";

const currentDate = new Date();
const sortedDates = [...importantDates].sort(
  (a, b) => a.due.getTime() - b.due.getTime(),
);

const featuredIndex = getFeaturedIndex(sortedDates, currentDate);
---

<section
  id="fechas"
  class="section section-important-dates"
  aria-labelledby="fechas-title"
>
  <div class="section-inner">
    <header class="section-header-inline">
      <h2 id="fechas-title">FECHAS IMPORTANTES</h2>
      <p>
        Aquí puedes encontrar las <span>fechas más próximas</span> de eventos de
        nuestra Iglesia <span>CENFOLIC</span>.
      </p>
    </header>
    <div class="important-dates-grid" aria-label="Eventos próximos">
      {
        sortedDates.map((date, index) => {
          const isFeatured = index === featuredIndex;
          const isPast =
            isPastDate(date.due, currentDate) && !isFeatured;
          const classes = [
            "date-card",
            isFeatured ? "date-card-featured" : "",
            isPast ? "is-past" : "",
          ]
            .filter(Boolean)
            .join(" ");

          return (
            <article class={classes}>
              <h3>{date.dueString}</h3>
              <p class="date-name">{date.name}</p>
              <p class="date-detail">{date.details}</p>
            </article>
          );
        })
      }
    </div>
  </div>
</section>


<style>
  .section {
    padding: var(--spacing-section-y) var(--spacing-page-x);
  }

  .section-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .section-header-inline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: baseline;
    margin-bottom: 2.5rem;
  }

  .section-header-inline h2 {
    font-size: var(--font-size-h2);
  }

  .section-header-inline p {
    max-width: 520px;
  }

  .section-header-inline span {
    font-weight: 700;
  }

  .section-important-dates {
    background: linear-gradient(
      135deg,
      var(--color-primary-soft-alt),
      #f7fbff
    );
  }

  .section-important-dates h2 {
    color: var(--color-primary);
  }

  .important-dates-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-grid-gap);
  }

  .date-card {
    border-radius: 22px;
    padding: 1.8rem 1.5rem 2rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-strong);
  }

  .date-card-featured {
    background-color: var(--color-primary);
    color: var(--color-text-soft);
    border-color: transparent;
    box-shadow: var(--shadow-card);
  }

  .date-card.is-past {
    opacity: 0.5;
  }

  .date-card h3 {
    font-size: 1rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
  }

  .date-name {
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .date-detail {
    font-size: var(--font-size-small);
  }

  @media (width <= 768px) {
    .important-dates-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

