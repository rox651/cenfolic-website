---
import { Image } from 'astro:assets';
import estrategiaImage from '../../assets/Estrategia.png';
---

<section
  id="estrategias"
  class="section section-strategies"
  aria-labelledby="estrategias-title"
>
  <div class="section-inner">
    <header class="section-header-centered">
      <h2 id="estrategias-title">
        Siete estrategias inspiradas en el <span>modelo de Jesús</span>
      </h2>
    </header>
    <div class="strategies-grid">
      <article class="strategy-card">
        <h3>División Educativa</h3>
        <p>Enseñanza bíblica y discipulado.</p>
      </article>
      <article class="strategy-card">
        <h3>Ministerio de Oración (Minora)</h3>
        <p>Intercesión constante y búsqueda de avivamiento.</p>
      </article>
      <article class="strategy-card">
        <h3>Misiones</h3>
        <p>Envío y apoyo de obreros para alcanzar las naciones.</p>
      </article>
      <article class="strategy-card">
        <h3>Sistema Celular</h3>
        <p>Crecimiento espiritual a través de grupos pequeños.</p>
      </article>
      <article class="strategy-card">
        <h3>Peregrinación a Jerusalén</h3>
        <p>Renovación espiritual y conexión con las raíces de la fe.</p>
      </article>
      <article class="strategy-card">
        <h3>Desarrollo Integral</h3>
        <p>Bienestar espiritual, emocional y físico.</p>
      </article>
      <article class="strategy-card">
        <h3>Liberación Financiera</h3>
        <p>Educación y administración responsable de los recursos.</p>
      </article>
      <div class="strategies-figure" aria-hidden="true">
        <Image
          src={estrategiaImage}
          alt="Estrategias de Iglesias CENFOLIC"
          class="strategies-figure-image"
          fetchpriority="low"
          loading="lazy"
          width={800}
          height={754}
        />
      </div>
    </div>
  </div>
</section>


<style>
  .section {
    padding: var(--spacing-section-y) var(--spacing-page-x);
  }

  .section-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .section-header-centered {
    text-align: center;
    margin-bottom: 2.75rem;
  }

  .section-header-centered h2 span {
    font-style: italic;
  }

  .section-strategies {
    background: radial-gradient(
      circle at top,
      #245faa 0,
      #082446 40%,
      #020813 100%
    );
    color: var(--color-text-soft);
  }

  .section-strategies .section-header-centered h2 {
    font-size: var(--font-size-h2);
  }

  .section-strategies .section-header-centered span {
    font-style: italic;
  }

  .strategies-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--spacing-grid-gap);
  }

  .strategy-card {
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 1.6rem 1.4rem 1.7rem;
    box-shadow: var(--shadow-card);
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .strategy-card h3 {
    font-size: 1.02rem;
    margin-bottom: 0.55rem;
  }

  .strategies-figure {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .strategies-figure-image {
    block-size: 158px;
    display: flex;
    align-items: center;
    justify-content: center;
    object-fit: contain;
  }

  @media (width <= 1024px) {
    .strategies-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (width <= 768px) {
    .strategies-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

