---
---

<section
  id="estrategias"
  class="section section-strategies"
  aria-labelledby="estrategias-title"
>
  <div class="section-inner">
    <header class="section-header-centered">
      <h2 id="estrategias-title">
        Siete estrategias inspiradas en el <span>modelo de Jesús</span>
      </h2>
    </header>
    <div class="strategies-grid">
      <article class="strategy-card">
        <h3>División Educativa</h3>
        <p>Enseñanza bíblica y discipulado.</p>
      </article>
      <article class="strategy-card">
        <h3>Ministerio de Oración (Minora)</h3>
        <p>Intercesión constante y búsqueda de avivamiento.</p>
      </article>
      <article class="strategy-card">
        <h3>Misiones</h3>
        <p>Envío y apoyo de obreros para alcanzar las naciones.</p>
      </article>
      <article class="strategy-card">
        <h3>Sistema Celular</h3>
        <p>Crecimiento espiritual a través de grupos pequeños.</p>
      </article>
      <article class="strategy-card">
        <h3>Peregrinación a Jerusalén</h3>
        <p>Renovación espiritual y conexión con las raíces de la fe.</p>
      </article>
      <article class="strategy-card">
        <h3>Desarrollo Integral</h3>
        <p>Bienestar espiritual, emocional y físico.</p>
      </article>
      <article class="strategy-card">
        <h3>Liberación Financiera</h3>
        <p>Educación y administración responsable de los recursos.</p>
      </article>
      <div class="strategies-figure" aria-hidden="true">
        <img
          src="/Estrategia.png"
          alt="Estrategias de Iglesias CENFOLIC"
          class="strategies-figure-image"
          fetchpriority="low"
          loading="lazy"
          width="800"
          height="754"
        />
      </div>
    </div>
  </div>
</section>


