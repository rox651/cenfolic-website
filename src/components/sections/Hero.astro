---
import { Image } from 'astro:assets';
import heroImage from '../../assets/Grupo-de-trabajo-cenfolic.webp';
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="hero-content">
    <div class="hero-text">
      <p class="hero-subtitle">Iglesias CENFOLIC</p>
      <h1 id="hero-title" class="hero-title">
        CONOCER<br />
        FORMAR<br />
        IMPACTAR
      </h1>
      <p class="hero-description">
        Guiamos a las personas a encontrarse con Cristo, a crecer en su fe y a
        transformar el mundo.
      </p>
      <a class="hero-button" href="#vision-mision"> Conoce nuestra misión </a>
    </div>
    <figure class="hero-image-wrapper">
      <Image
        src={heroImage}
        alt="Equipo pastoral de Iglesias CENFOLIC"
        class="hero-image"
        loading="eager"
        width={800}
        height={450}
      />
    </figure>
  </div>
</section>


<style>
  .hero {
    max-width: 1120px;
    margin: 0 auto;
    background-color: var(--color-surface);
    padding: 0 var(--spacing-page-x);
  }

  .hero-content {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
    gap: 3.25rem;
    align-items: center;
  }

  .hero-text {
    max-width: 32rem;
  }

  .hero-subtitle {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--color-secondary);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .hero-title {
    font-size: var(--font-size-h1);
    color: var(--color-primary);
    margin-bottom: 1.25rem;
  }

  .hero-description {
    margin-bottom: 2rem;
    max-width: 26rem;
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 2.6rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-primary);
    color: var(--color-surface);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: var(--shadow-soft);
  }

  .hero-button:hover,
  .hero-button:focus-visible {
    text-decoration: none;
    background-color: var(--color-primary-light);
  }

  .hero-image-wrapper {
    position: relative;
  }

  .hero-image-wrapper::before {
    content: "";
    position: absolute;
    bottom: 0;
    right: 0;
    pointer-events: none;
    background-color: var(--color-primary-soft);
    border-radius: var(--hero-image-radius);
    width: 100%;
    height: 50%;
    z-index: 0;
  }

  .hero-image {
    border-radius: calc(var(--hero-image-radius) - 10px);
    width: 100%;
    position: relative;
    z-index: 1;
    object-fit: contain;
  }

  @media (width <= 1024px) {
    .hero-content {
      gap: 2.25rem;
    }
  }

  @media (width <= 768px) {
    .hero-content {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 0.75rem;
    }

    .hero-text {
      order: 2;
    }

    .hero-image-wrapper {
      padding-inline: 1.1rem;
    }

    .hero-image {
      height: 200px;
    }
  }
</style>
