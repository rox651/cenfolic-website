---
import { Image } from 'astro:assets';
import Hero from "./sections/Hero.astro";
import logo from '../assets/cenfolic-logo.png';
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="Ir al inicio de Iglesias CENFOLIC">
      <Image
        src={logo}
        alt="Logo Iglesias CENFOLIC"
        class="brand-logo"
        loading="eager"
        width={797}
        height={239}
      />
    </a>
    <button
      id="menu-toggle"
      class="nav-toggle"
      type="button"
      aria-label="Abrir menú principal"
      aria-expanded="false"
      aria-controls="primary-navigation"
    >
      <svg
        stroke="currentColor"
        fill="currentColor"
        stroke-width="0"
        viewBox="0 0 24 24"
        height="200px"
        width="200px"
        xmlns="http://www.w3.org/2000/svg"
      >
        <g id="Menu_Fries">
          <path
            d="M20.437,19.937c0.276,0 0.5,0.224 0.5,0.5c0,0.276 -0.224,0.5 -0.5,0.5l-16.874,0.002c-0.276,-0 -0.5,-0.224 -0.5,-0.5c-0,-0.276 0.224,-0.5 0.5,-0.5l16.874,-0.002Z"
          >
          </path>
          <path
            d="M20.437,11.5c0.276,-0 0.5,0.224 0.5,0.5c0,0.276 -0.224,0.5 -0.5,0.5l-10,0.001c-0.276,-0 -0.5,-0.224 -0.5,-0.5c-0,-0.276 0.224,-0.5 0.5,-0.5l10,-0.001Z"
          >
          </path>
          <path
            d="M20.437,3.062c0.276,-0 0.5,0.224 0.5,0.5c0,0.276 -0.224,0.5 -0.5,0.5l-16.874,0.001c-0.276,-0 -0.5,-0.224 -0.5,-0.5c-0,-0.276 0.224,-0.5 0.5,-0.5l16.874,-0.001Z"
          >
          </path>
        </g>
      </svg>
    </button>
    <nav
      id="primary-navigation"
      class="primary-nav"
      aria-label="Navegación principal"
    >
      <ul class="nav-list">
        <li><a href="/">Inicio</a></li>
        <li><a href="#somos">Somos</a></li>
        <li><a href="#vision-mision">Visión</a></li>
        <li><a href="#estrategias">Estrategias</a></li>
        <li><a href="#sedes">Sedes</a></li>
        <li><a href="#contacto">Contacto</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import { initNavigation } from "../helpers/navigation";

  if (typeof window !== "undefined") {
    initNavigation();
  }
</script>


<style>
  .site-header {
    background-color: var(--color-surface);
    padding: var(--spacing-page-y) var(--spacing-page-x) 2.75rem;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1120px;
    margin: 0 auto 2.5rem;
    gap: 1rem;
    min-height: var(--header-height);
  }

  .brand-logo {
    object-fit: contain;
    height: 6rem;
  }

  .primary-nav {
    display: flex;
  }

  .nav-list {
    list-style: none;
    display: flex;
    gap: 2.25rem;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .nav-list a {
    position: relative;
    padding-block: 0.3rem;
    color: var(--color-primary);
    font-weight: 600;
  }

  .nav-list a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-accent);
    transition: width 160ms ease-out;
  }

  .nav-list a:hover::after,
  .nav-list a:focus-visible::after {
    width: 100%;
  }

  .nav-toggle {
    display: none;
    border: none;
    background: transparent;
    padding: 0.25rem;
    border-radius: 0.5rem;
    cursor: pointer;
  }

  .nav-toggle:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (width <= 1024px) {
    .site-header {
      padding-inline: var(--spacing-page-x);
      padding-top: 1.25rem;
      padding-bottom: 2.25rem;
    }

    .header-inner {
      margin-bottom: 1.6rem;
    }

    .primary-nav {
      position: absolute;
      inset-inline: 0;
      top: 5rem;
      transform: translateY(-100%);
      opacity: 0;
      pointer-events: none;
      transition: transform 160ms ease-out, opacity 160ms ease-out;
      background-color: rgba(255, 255, 255, 0.98);
      z-index: 20;
    }

    .primary-nav.is-open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .brand-logo {
      block-size: auto;
      width: 150px;
      object-fit: contain;
    }

    .nav-list {
      flex-direction: column;
      padding: 0.75rem 1.5rem 1.2rem;
      gap: 0.4rem;
    }

    .nav-list a {
      padding-block: 0.45rem;
    }

    .nav-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .nav-toggle svg {
      width: 24px;
      height: 24px;
    }
  }
</style>

