---
import { Image } from 'astro:assets';
import logo from '../assets/cenfolic-logo.png';
---

<footer id="contacto" class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <Image
        src={logo}
        alt="Logo Iglesias CENFOLIC"
        class="footer-logo-main"
        width={797}
        height={239}
      />
    </div>

    <section
      class="footer-social footer-social-instagram"
      aria-label="Redes sociales de Instagram"
    >
      <header class="footer-social-heading">
        <div class="footer-icon" aria-hidden="true">
          <svg
            stroke="currentColor"
            fill="currentColor"
            stroke-width="0"
            viewBox="0 0 448 512"
            height="200px"
            width="200px"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"
            >
            </path>
          </svg>
        </div>
        <div class="footer-social-heading-text">
          <p class="footer-social-platform">Instagram</p>
          <p class="footer-social-handle">CENFOLIC</p>
        </div>
      </header>
      <ul class="footer-social-list">
        <li>
          <a
            href="https://www.instagram.com/cenfolicmmontt"
            target="_blank"
            rel="noopener noreferrer"
          >
            cenfolicmmontt
          </a>
        </li>
        <li>
          <a
            href="https://www.instagram.com/cenfolicmaipu_"
            target="_blank"
            rel="noopener noreferrer"
          >
            cenfolicmaipu_
          </a>
        </li>
        <li>
          <a
            href="https://www.instagram.com/cenfolicpenalolen"
            target="_blank"
            rel="noopener noreferrer"
          >
            cenfolicpenalolen
          </a>
        </li>
        <li>
          <a
            href="https://www.instagram.com/cenfolic.laserena"
            target="_blank"
            rel="noopener noreferrer"
          >
            cenfolic.laserena
          </a>
        </li>
      </ul>
    </section>

    <section
      class="footer-social footer-social-youtube"
      aria-label="Canales de YouTube"
    >
      <header class="footer-social-heading">
        <div class="footer-icon" aria-hidden="true">
          <svg
            stroke="currentColor"
            fill="#E9333D"
            stroke-width="0"
            viewBox="0 0 576 512"
            height="32px"
            width="32px"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M549.655 124.083c-6.281-23.65-24.787-42.276-48.284-48.597C458.781 64 288 64 288 64S117.22 64 74.629 75.486c-23.497 6.322-42.003 24.947-48.284 48.597-11.412 42.867-11.412 132.305-11.412 132.305s0 89.438 11.412 132.305c6.281 23.65 24.787 41.5 48.284 47.821C117.22 448 288 448 288 448s170.78 0 213.371-11.486c23.497-6.321 42.003-24.171 48.284-47.821 11.412-42.867 11.412-132.305 11.412-132.305s0-89.438-11.412-132.305zm-317.51 213.508V175.185l142.739 81.205-142.739 81.201z"
            >
            </path>
          </svg>
        </div>
        <div class="footer-social-heading-text">
          <p class="footer-social-platform">YouTube</p>
          <p class="footer-social-handle">CENFOLIC</p>
        </div>
      </header>
      <ul class="footer-social-list">
        <li>
          <a
            href="https://www.youtube.com/@Cenfolic"
            target="_blank"
            rel="noopener noreferrer"
          >
            @Cenfolic
          </a>
        </li>
        <li>
          <a
            href="https://www.youtube.com/@CenfolicManuelMontt"
            target="_blank"
            rel="noopener noreferrer"
          >
            @CenfolicManuelMontt
          </a>
        </li>
      </ul>
    </section>
  </div>

  <div class="footer-bottom">
    <p class="footer-contact-line">
      <svg
        stroke="currentColor"
        fill="currentColor"
        stroke-width="0"
        viewBox="0 0 256 256"
        height="200px"
        width="200px"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M200,224H150.54A266.56,266.56,0,0,0,174,200.25c27.45-31.57,42-64.85,42-96.25a88,88,0,0,0-176,0c0,31.4,14.51,64.68,42,96.25A266.56,266.56,0,0,0,105.46,224H56a8,8,0,0,0,0,16H200a8,8,0,0,0,0-16ZM128,72a32,32,0,1,1-32,32A32,32,0,0,1,128,72Z"
        >
        </path>
      </svg>
      Asturias 271, Las Condes
    </p>
    <p class="footer-contact-line">
      <a href="mailto:cenfolicnacional@cenlimi.com">
        cenfolicnacional@cenlimi.com
      </a>
    </p>
    <p class="footer-legal">
      &copy; 2025 CENFOLIC – CENTRO DE FORMACIÓN DE LÍDERES CRISTIANOS
    </p>
  </div>
</footer>


<style>
  .site-footer {
    background: linear-gradient(180deg, #e4f0ff 0%, #f3f8ff 100%);
    color: var(--color-primary);
    padding: 2.75rem var(--spacing-page-x) 2.25rem;
  }

  .footer-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.1fr) minmax(0, 1.1fr);
    gap: 2.5rem;
    align-items: start;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .footer-logo-main {
    max-width: 100%;
    block-size: 5rem;
    object-fit: contain;
  }

  .footer-legal {
    font-size: 0.78rem;
    opacity: 0.85;
  }

  .footer-title {
    font-size: 1rem;
    margin-bottom: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .footer-contact p + p {
    margin-top: 0.25rem;
  }

  .footer-contact a {
    color: var(--color-primary);
  }

  .footer-contact a:hover,
  .footer-contact a:focus-visible {
    color: var(--color-accent);
  }

  .footer-social-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    font-size: 0.86rem;
  }

  .footer-social-list a {
    color: var(--color-primary);
    padding: 0.25rem 0;
    display: inline-block;
  }

  .footer-social-list a:hover,
  .footer-social-list a:focus-visible {
    color: var(--color-accent);
  }

  .footer-social-heading {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.75rem;
  }

  .footer-icon svg {
    width: 32px;
    height: 32px;
  }

  .footer-social-platform {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .footer-social-handle {
    font-weight: 700;
  }

  .footer-bottom {
    max-width: 1120px;
    margin: 2rem auto 0;
    text-align: center;
    font-size: 0.82rem;
    color: var(--color-primary);
  }

  .footer-contact-line {
    justify-content: center;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .footer-contact-line svg {
    width: 20px;
    height: 20px;
  }

  .footer-contact-line + .footer-contact-line {
    margin-top: 0.15rem;
  }

  .footer-bottom a {
    color: var(--color-primary);
  }

  .footer-bottom a:hover,
  .footer-bottom a:focus-visible {
    color: var(--color-accent);
  }

  .footer-legal {
    margin-top: 0.75rem;
    font-size: 0.78rem;
  }

  @media (width <= 1024px) {
    .footer-inner {
      grid-template-columns: minmax(0, 1fr);
      text-align: center;
    }

    .footer-social-heading {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }

  @media (width <= 768px) {
    .footer-inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

