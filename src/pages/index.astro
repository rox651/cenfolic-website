---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AboutSection from "../components/sections/AboutSection.astro";
import VisionMissionSection from "../components/sections/VisionMissionSection.astro";
import StrategiesSection from "../components/sections/StrategiesSection.astro";
import MovementsSection from "../components/sections/MovementsSection.astro";
import ImportantDatesSection from "../components/sections/ImportantDatesSection.astro";
import LocationsSection from "../components/sections/LocationsSection.astro";
---

<BaseLayout>
  <Header />
  <main id="main-content">
    <AboutSection />
    <VisionMissionSection />
    <StrategiesSection />
    <MovementsSection />
    <ImportantDatesSection />
    <LocationsSection />
  </main>
  <Footer />
</BaseLayout>
