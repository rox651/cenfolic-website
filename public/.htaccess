# Enable ETags for better caching
FileETag MTime Size

# Enable compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# Cache static assets for 1 year
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Fonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  
  # CSS and JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  
  # Audio files (podcasts)
  ExpiresByType audio/mpeg "access plus 1 year"
  ExpiresByType audio/mp3 "access plus 1 year"
  ExpiresByType audio/ogg "access plus 1 year"
  
  # HTML - cache for 1 hour (can be revalidated)
  ExpiresByType text/html "access plus 1 hour"
  
  # XML files (sitemap) - cache for 1 day
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
  
  # RSS feed - no cache (always fetch fresh content)
  ExpiresByType application/rss+xml "access plus 0 seconds"
</IfModule>

# Cache-Control headers (complement to Expires)
<IfModule mod_headers.c>
  # Cache static assets for 1 year
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|otf|css|js|mp3|ogg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Cache HTML for 1 hour (with revalidation)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  
  # Cache XML files for 1 day (sitemap and other XML)
  <FilesMatch "\.xml$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  
  # RSS feed - no cache (always fetch fresh content) - must be after general XML rule to override it
  <Files "rss.xml">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>
  
  # Remove ETag for better caching (optional, but recommended with Cache-Control)
  Header unset ETag
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  # Support byte-range requests for podcast streaming (required by Apple Podcasts/Spotify)
  Header set Accept-Ranges bytes
</IfModule>

# Enable browser caching
<IfModule mod_headers.c>
  # Remove Last-Modified header to prevent conditional requests
  Header unset Last-Modified
</IfModule>



